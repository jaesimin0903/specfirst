NEXT_PUBLIC_REGISTRY_10143=
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_REPORT_BASE=
# Optional. Comma-separated hosts this server is allowed to fetch report.json from.
# Defaults to NEXT_PUBLIC_REPORT_BASE's own host plus raw.githubusercontent.com.
NEXT_PUBLIC_REPORT_ALLOWED_HOSTS=
NEXT_PUBLIC_DEMO_VAULT_CERTIFIED=
NEXT_PUBLIC_DEMO_VAULT_UNCERTIFIED=
# Board data (read by `pnpm --filter @specfirst/web board:build`, not by the running app).
# Directory of <chainId>/<address>/*.json check reports; relative paths resolve against the repository root.
SPECFIRST_BOARD_SOURCE=certs/checks
# CheckAttestationRegistry on Monad testnet and the RPC used to read it (eth_call only). SPECFIRST_BOARD_OFFLINE=1 skips it.
SPECFIRST_BOARD_REGISTRY=0x3754918bBB8481D046D80718a9efe434e353daF7
SPECFIRST_BOARD_RPC=https://testnet-rpc.monad.xyz
SPECFIRST_BOARD_OFFLINE=
# Request desk (/check, /check/<id>, /desk). Unset desk address: the pages show "desk not deployed".
NEXT_PUBLIC_SPECFIRST_DESK_10143=
# Monad mainnet RPC for the pre-check (view calls only).
SPECFIRST_MAINNET_RPC=https://rpc.monad.xyz
# Worker progress file and requested reports; relative paths resolve against the repository root.
SPECFIRST_WORKER_STATUS=.specfirst/worker/status.json
SPECFIRST_CHECKS_DIR=certs/checks
NEXT_PUBLIC_MONAD_FAUCET_URL=https://faucet.monad.xyz
# Watcher (ADR 0006): /watch, /watch/inbox, the board overlay and vault history read <dir>/<chainId>/{feed.ndjson,status.json,vaults.json}
# at request time. Relative paths resolve against the repository root; default .specfirst/watch.
SPECFIRST_WATCH_DIR=
# CheckSubscriptions on Monad testnet. Unset: the subscribe box and the inbox say "not deployed yet".
NEXT_PUBLIC_SPECFIRST_SUBS_10143=
# 1 lets webhooks register http://localhost and http://127.0.0.1 URLs (demo on a dev machine). Leave unset in production.
SPECFIRST_ALLOW_LOCAL_HTTP_WEBHOOKS=
# off disables the demo webhook receiver (/api/v1/watch/demo-hook and /watch/demo-hook).
SPECFIRST_DEMO_HOOK=
