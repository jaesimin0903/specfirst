exports[`CertificateView, four states > partial: only some invariants passed 1`] = `
<div>
  <main
    class="page"
  >
    <div
      class="bar"
    >
      <span
        class="url"
      >
        specfirst / c / 
        0x4a1f00000000000000000000000000000000c9e2
      </span>
    </div>
    <div
      class="row header-row"
    >
      <span
        class="pill pill-warn"
      >
        Partial verification
      </span>
      <span
        class="muted"
      >
        issued 
        3 days ago
      </span>
    </div>
    <h1
      class="h"
    >
      StakingVault
    </h1>
    <dl
      class="meta-list"
    >
      <div>
        <dt>
          address
        </dt>
        <dd>
          0x4a1f00000000000000000000000000000000c9e2
          , monad-testnet (
          10143
          )
        </dd>
      </div>
      <div>
        <dt>
          spec
        </dt>
        <dd>
          0xb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2
        </dd>
      </div>
      <div>
        <dt>
          invariant set
        </dt>
        <dd>
          0xc3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3
        </dd>
      </div>
      <div>
        <dt>
          property
        </dt>
        <dd>
          0xd4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4
        </dd>
      </div>
      <div>
        <dt>
          code
        </dt>
        <dd>
          0xe5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5
        </dd>
      </div>
    </dl>
    <p
      class="notice warn"
    >
      Partial certificate: only 
      5
       of 
      7
       invariants passed. A partial certificate never replaces a complete earlier one.
    </p>
    <div
      class="grid-2"
    >
      <div
        class="box"
      >
        <div
          class="box-label"
        >
          Verified invariants (
          2
          )
        </div>
        <ul
          class="check-list"
        >
          <li
            class="ok"
          >
            <span
              class="mark"
            >
              ✓
            </span>
            <span>
              total supply equals the sum of minted balances
            </span>
          </li>
          <li
            class="ok"
          >
            <span
              class="mark"
            >
              ✓
            </span>
            <span>
              only the owner can withdraw
            </span>
          </li>
        </ul>
      </div>
      <div
        class="box box-dashed"
      >
        <div
          class="box-label"
        >
          Not verified (
          2
          )
        </div>
        <ul
          class="plain-list"
        >
          <li>
            oracle manipulation
          </li>
          <li>
            economic attacks
          </li>
        </ul>
      </div>
    </div>
    <div
      class="grid-2"
    >
      <div
        class="box"
      >
        <div
          class="box-label"
        >
          Fuzzing
        </div>
        <div>
          summary not available
        </div>
      </div>
      <div
        class="box"
      >
        <div
          class="box-label"
        >
          Post-deploy verification
        </div>
        <div>
          30
           rehearsal tx, 
          5
          /
          7
           invariants held
        </div>
      </div>
    </div>
    <div
      class="row actions"
    >
      <a
        class="btn"
        href="https://testnet.monadvision.com/address/0x4a1f00000000000000000000000000000000c9e2"
        rel="noreferrer"
        target="_blank"
      >
        view on explorer
      </a>
      <a
        class="btn"
        href="https://example.test/report.json"
        rel="noreferrer"
        target="_blank"
      >
        report.json
      </a>
      <span
        class="hash-check muted"
      >
        report hash not verified (
        no network in tests
        )
      </span>
    </div>
    <p
      class="muted small"
    >
      report hash 
      0xf6f6f6...f6f6f6
    </p>
  </main>
</div>
`;

