MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_FALLBACKS=https://rpc.ankr.com/monad_testnet,https://rpc-testnet.monadinfra.com
DEPLOYER_PRIVATE_KEY=
ISSUER_PRIVATE_KEY=
# Pays the fee of `specfirst desk request` (testing the desk); never the deployer or the worker key.
REQUESTER_PRIVATE_KEY=
# Signs the attestations of `specfirst watch`: a second registry issuer, so the watcher and the desk worker never share nonces.
WATCH_ISSUER_PRIVATE_KEY=
# Signs the exits of `specfirst watch demo gate keep` (anyone may exit a vault that is not compliant); never the owner's key.
KEEPER_PRIVATE_KEY=
# Signs the attestations of the testnet demo watcher (`watch --subject-chain 10143 --issuer-key-env WATCH_DEMO_ISSUER_PRIVATE_KEY`).
WATCH_DEMO_ISSUER_PRIVATE_KEY=
# Contracts on Monad testnet, printed by their deploy commands. Not keys: the server gets them all (deploy/server.env.example), the web three.
SPECFIRST_ATTEST_REGISTRY_10143=
SPECFIRST_DESK_10143=
SPECFIRST_SUBS_10143=
SPECFIRST_DEMO_TOKEN_10143=
SPECFIRST_GATE_10143=
