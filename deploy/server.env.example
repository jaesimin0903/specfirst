# The secret file of the four signing services, /etc/specfirst/specfirst.env on the server (SPECFIRST_ENV_FILE in
# deploy/.env): only what they read. DEPLOYER_PRIVATE_KEY, the owner of every contract, stays off the server.
# docs/deploy.md shows how to make it from the Mac's .env without copying the rest. chown 1000:1000, chmod 600.

MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_FALLBACKS=https://rpc.ankr.com/monad_testnet,https://rpc-testnet.monadinfra.com
SPECFIRST_ATTEST_REGISTRY_10143=
SPECFIRST_DESK_10143=
SPECFIRST_SUBS_10143=
SPECFIRST_DEMO_TOKEN_10143=
SPECFIRST_GATE_10143=

# watch-143 attests with it.
WATCH_ISSUER_PRIVATE_KEY=
# watch-10143 attests with it.
WATCH_DEMO_ISSUER_PRIVATE_KEY=
# worker: the desk's worker address, attests and fulfils with it.
ISSUER_PRIVATE_KEY=
# gate-keeper signs exits with KEEPER_PRIVATE_KEY, else REQUESTER_PRIVATE_KEY. The Mac has only the second, which
# `desk request` and `subs subscribe` also pay from; a key of its own for the keeper keeps those apart.
KEEPER_PRIVATE_KEY=
