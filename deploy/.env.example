# Settings of deploy/docker-compose.yml. Copy to deploy/.env on the server. Nothing in this file is a key: the keys
# live only in the file SPECFIRST_ENV_FILE names (deploy/server.env.example), which the web never sees.

# The site's host name, lowercase. Its DNS record must point at this server before Caddy starts.
DOMAIN=specfirst.example.org
# "https" runs Caddy. Add "signers" (the watchers, the worker and the keeper) only after the Mac services are
# stopped: docs/deploy.md, Migration.
COMPOSE_PROFILES=https

# The signers' secret file: keys, contract addresses, RPCs. chown 1000:1000, chmod 600.
SPECFIRST_ENV_FILE=/etc/specfirst/specfirst.env

# The site's origin, default https://$DOMAIN. Set it only if the site is served elsewhere; then exactly
# scheme://host[:port], lowercase, no trailing slash (the watchers refuse anything else). It is the origin the
# watchers may deliver webhooks to although it resolves inside this host (Caddy's alias on the compose network),
# and the origin of the web's absolute API links.
#PUBLIC_ORIGIN=

# Host port of the web on 127.0.0.1, for curl on the server. Caddy reaches the web inside the network.
WEB_PORT=3000

# RPC that reads CheckAttestationRegistry when the image builds the board (the public testnet RPC allows 15
# requests per second).
SPECFIRST_BOARD_RPC=https://rpc.ankr.com/monad_testnet

# First three octets of the compose network (a /24). The watchers sit at .11 and .12; change it only if it clashes
# with a network the server already has.
#SPECFIRST_NET=172.30.17

# The contracts the web shows: SPECFIRST_DESK_10143, SPECFIRST_SUBS_10143 and SPECFIRST_GATE_10143, the lines of
# SPECFIRST_ENV_FILE, appended without opening the rest of that file:
#   sudo grep -E '^SPECFIRST_(DESK|SUBS|GATE)_10143=' /etc/specfirst/specfirst.env >> deploy/.env
