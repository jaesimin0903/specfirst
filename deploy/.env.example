# Settings of deploy/docker-compose.yml. Copy to deploy/.env on the server. Nothing in this file is a key: keys live
# only in the file SPECFIRST_ENV_FILE names, which the CLI services read and the web never sees.

# The site's host name. Its DNS record must point at this server before Caddy starts.
DOMAIN=specfirst.example.org
# "https" runs Caddy. Add "signers" (the watchers, the worker and the keeper) only after the Mac services are
# stopped: docs/deploy.md, Migration.
COMPOSE_PROFILES=https

# The server's copy of the Mac's .env (same variable names as .env.example), chown 1000:1000, chmod 600.
SPECFIRST_ENV_FILE=/etc/specfirst/specfirst.env

# The origin watchers may deliver to although it resolves inside this host (Caddy's alias on the compose network).
# Default https://$DOMAIN, the demo receiver /watch/inbox offers.
#PUBLIC_ORIGIN=

# Host port of the web on 127.0.0.1, for curl on the server. Caddy reaches the web inside the network.
WEB_PORT=3000

# RPC that reads CheckAttestationRegistry when the image builds the board (the public testnet RPC allows 15
# requests per second).
SPECFIRST_BOARD_RPC=https://rpc.ankr.com/monad_testnet

# The web's non-secret variables: these lines of SPECFIRST_ENV_FILE, copied as they are. This prints them:
#   grep -E '^(MONAD_TESTNET_RPC|MONAD_TESTNET_RPC_FALLBACKS|SPECFIRST_(ATTEST_REGISTRY|DESK|SUBS|DEMO_TOKEN|GATE)_10143)=' /etc/specfirst/specfirst.env
MONAD_TESTNET_RPC=
MONAD_TESTNET_RPC_FALLBACKS=
SPECFIRST_ATTEST_REGISTRY_10143=
SPECFIRST_DESK_10143=
SPECFIRST_SUBS_10143=
SPECFIRST_DEMO_TOKEN_10143=
SPECFIRST_GATE_10143=
